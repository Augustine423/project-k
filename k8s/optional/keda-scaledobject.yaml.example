# KEDA: warm standby (min 1) + scale on active rooms via C# metrics API.
# Requires KEDA CRDs — run once: bash k8s/install-keda.sh
# Then: kubectl apply -f k8s/optional/keda-scaledobject.yaml.example
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: livekit-sfu-scaler
spec:
  scaleTargetRef:
    name: livekit-sfu
  minReplicaCount: 1
  maxReplicaCount: 10
  pollingInterval: 10
  cooldownPeriod: 300
  advanced:
    horizontalPodAutoscalerConfig:
      behavior:
        scaleDown:
          stabilizationWindowSeconds: 600
          policies:
          - type: Pods
            value: 1
            periodSeconds: 120
        scaleUp:
          stabilizationWindowSeconds: 0
          policies:
          - type: Pods
            value: 2
            periodSeconds: 15
  triggers:
  - type: metrics-api
    metadata:
      url: "http://kzys-backend-csharp:8080/api/rooms/scaling/metrics"
      valueLocation: "desiredSfuPods"
      targetValue: "1"
      format: "json"
