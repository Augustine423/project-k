# Copy to project root as `.env` before running: docker compose up --build
# Production: inject via K8s Secrets / Vault — never commit real secrets.

# Local compose builds images tagged as ${DOCKERHUB_USER}/project-k-{web,csharp}.
# pull_policy=missing → use local build; set always + use docker-compose.image.yaml to pull Hub only.
DOCKERHUB_USER=kyawzayarsoe
IMAGE_TAG=latest
PULL_POLICY=missing
# Leave empty for same-origin /api behind nginx (recommended).
VITE_API_URL=

JWT_SIGNING_SECRET=dev-jwt-signing-secret
TURN_SHARED_SECRET=dev-turn-shared-secret
TURN_REALM=kzys.local

# LiveKit SFU (video/audio)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-local-secret-32chars-min
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_PUBLIC_URL=ws://localhost:7880
STUN_SERVER=stun.l.google.com

# Public URLs the browser uses (dev = plain HTTP/WS; prod = HTTPS/WSS)
PUBLIC_HOST=192.168.1.x
# ICE address LiveKit advertises (LAN/public IP reachable by every client, including phones).
LIVEKIT_NODE_IP=192.168.1.x
# Leave empty for HTTPS Vite (same-origin /api proxy). Set only for plain-HTTP UI.
PUBLIC_API_URL=
# On a public VM with nginx UI: usually same-origin via :WEB_PORT proxy, or ws://YOUR_HOST:7880
LIVEKIT_PUBLIC_URL=wss://192.168.1.x/livekit
CORS_ORIGIN=*

TURN_USE_TLS=false
TURN_PORT=3478
TURN_TLS_PORT=5349

SERVER_PORT=4000
# nginx UI ports when using docker compose (service: web)
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# Vite-only dev (cd web && npm run dev) — not used by docker compose web service
WEB_DEV_PORT=5174
# Local docker: keep modest. K8s / stress: see k8s/01-configmap.yaml or docker-compose.stress.yaml.
MAX_ROOM_PARTICIPANTS=10000
LARGE_ROOM_EVENT_THRESHOLD=500
PARTICIPANTS_PAGE_SIZE=50
PARTICIPANTS_SEARCH_SCAN_CAP=10000
WEBINAR_ENTER_LISTENERS=10000
WEBINAR_EXIT_LISTENERS=50
INTERACTIVE_MAX_PUBLISHERS=10000
WEBINAR_MAX_PUBLISHERS=50
WEBINAR_ENTER_RATIO=8.0
SFU_PUBLISHERS_PER_NODE=100
KZYS_SFU_STANDBY_POOL=2

# Docker Compose stress overlay (docker-compose.stress.yaml)
# POSTGRES_PASSWORD=kzys-stress-test
# REDIS_MAXMEMORY=512mb
# SERVER_CPU_LIMIT=2
# LIVEKIT_CPU_LIMIT=4

# Optional: PostgreSQL for multi-replica control plane (leave unset for SQLite)
# DATABASE_URL=postgresql://user:pass@host:5432/kzys
