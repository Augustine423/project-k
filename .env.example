# Copy to project root as `.env` before running: docker compose up --build
# Production: inject via K8s Secrets / Vault — never commit real secrets.

JWT_SIGNING_SECRET=dev-jwt-signing-secret
TURN_SHARED_SECRET=dev-turn-shared-secret
TURN_REALM=kzys.local

# LiveKit SFU (video/audio)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-local-secret-32chars-min
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_PUBLIC_URL=ws://localhost:7880
STUN_SERVER=stun.l.google.com

# Public URLs the browser uses (dev = plain HTTP/WS; prod = HTTPS/WSS)
PUBLIC_HOST=192.168.1.x
# ICE address LiveKit advertises (LAN/public IP reachable by every client, including phones).
LIVEKIT_NODE_IP=192.168.1.x
PUBLIC_API_URL=http://192.168.1.x:4000
CORS_ORIGIN=*

TURN_USE_TLS=false
TURN_PORT=3478
TURN_TLS_PORT=5349

SERVER_PORT=4000
WEB_PORT=5173
# Local docker: keep modest. Scaled K8s deploy: set MAX_ROOM_PARTICIPANTS=10000.
MAX_ROOM_PARTICIPANTS=500
WEBINAR_ENTER_LISTENERS=45
WEBINAR_EXIT_LISTENERS=20
INTERACTIVE_MAX_PUBLISHERS=50
WEBINAR_MAX_PUBLISHERS=16
