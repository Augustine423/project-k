# Copy to project root as `.env` before running: docker compose up --build
# Production: inject via K8s Secrets / Vault — never commit real secrets.

JWT_SIGNING_SECRET=dev-jwt-signing-secret
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
TURN_SHARED_SECRET=dev-turn-shared-secret
TURN_REALM=kzys.local

# Public URLs the browser uses (dev = plain HTTP/WS; prod = HTTPS/WSS)
# Desktop-only: leave as localhost.
# Mobile on same Wi‑Fi: set PUBLIC_HOST to your PC's LAN IP (ipconfig → IPv4).
PUBLIC_HOST=localhost
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=*
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# TLS Phase A: set TURN_USE_TLS=true and LIVEKIT_PUBLIC_URL=wss://... in production
TURN_USE_TLS=false
TURN_PORT=3478
TURN_TLS_PORT=5349

SERVER_PORT=4000
WEB_PORT=5173
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881

# --- GKE testing (runtime only — NOT baked into Docker images) ---
# 1. Push images via GitHub Actions (web built with empty VITE_API_URL).
# 2. cp k8s/secrets.example.yaml k8s/secrets.yaml && fill values.
# 3. Edit k8s/base/config/app-configmap.yaml (APP_HOST, LIVEKIT_URL, TURN_HOST).
# 4. cp k8s/base/gateway/tls-secret.example.yaml k8s/base/gateway/tls-secret.yaml && add cert.
# 5. kubectl apply -k k8s/overlays/gke
# 6. kubectl get gateway kzys-gateway -n kzys → point DNS A/AAAA to Gateway IP.
# 7. kubectl get svc livekit-media coturn-media -n kzys → set MEDIA_NODE_IP + TURN_HOST in app-configmap, re-apply.
