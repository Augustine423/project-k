# Copy this file to infra/.env and adjust before running docker compose.

# --- Shared secrets (generate real random values before anything but local dev) ---
JANUS_ADMIN_SECRET=dev-janus-admin-secret
JANUS_VIDEOROOM_ADMIN_KEY=dev-janus-videoroom-key
TURN_SHARED_SECRET=dev-turn-shared-secret
JWT_SIGNING_SECRET=dev-jwt-signing-secret

# --- Networking ---
# Set to your LAN/public IP if joining from another device; localhost is fine
# for same-machine browser testing.
STUN_SERVER=stun.l.google.com
PUBLIC_HOST=localhost

# --- Ports ---
SERVER_PORT=4000
WEB_PORT=5173
JANUS_HTTP_PORT=8088
JANUS_ADMIN_PORT=7088
JANUS_WS_PORT=8188
TURN_PORT=3478
