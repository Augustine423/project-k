# All rooms are created dynamically by the control plane (server/src/janus)
# via the plugin's Admin API "create" request, keyed off our own room
# registry in Redis -- nothing is hardcoded here. This keeps the platform's
# idea of a "room" and Janus's idea of a "videoroom" always in sync.
general: {
    admin_key = "${JANUS_VIDEOROOM_ADMIN_KEY}"
    lock_rtp_forward = true

    # Use string IDs so our control plane's UUID room IDs map cleanly to Janus.
    string_ids = true

    # Default max video bitrate per publisher for dynamically created rooms
    # (1.5 Mbps = good quality 720p). Rooms created via the Admin API can
    # override this per-room. Upstream demo default is 128 kbps — far too low.
    bitrate = 1500000

    # Hard-cap: publishers cannot negotiate above 'bitrate' even if they try.
    # Without this, the value is only a suggestion and can be exceeded.
    bitrate_cap = true

    # Request a keyframe from publishers every 10 seconds so late-joining
    # subscribers and recovering connections get a clean picture promptly.
    fir_freq = 10

    # Codec preference order: VP9 first (better quality/compression than VP8),
    # fall back to VP8, then H.264 for devices that don't support VP9.
    videocodec = "vp9,vp8,h264"

    # Prefer Opus for audio (default, but explicit is better).
    audiocodec = "opus"

    # Opus in-band FEC: Opus encodes a low-bitrate copy of the previous frame
    # inside the current packet. On packet loss the receiver can partially
    # reconstruct the lost audio — noticeably reduces audio glitches.
    # Upstream default is true; we make it explicit here.
    opus_fec = true

    # Fire "talking" / "stopped-talking" events to all room members when a
    # publisher's audio level changes. The frontend uses these to drive active
    # speaker detection and selective video subscription.
    audiolevel_ext = true
    audiolevel_event = true
    audio_active_packets = 50
    audio_level_average = 30
}
