general: {
    configs_folder = "/opt/janus/etc/janus"
    plugins_folder = "/opt/janus/lib/janus/plugins"
    transports_folder = "/opt/janus/lib/janus/transports"
    events_folder = "/opt/janus/lib/janus/events"
    loggers_folder = "/opt/janus/lib/janus/loggers"

    # Every Janus node gets a unique, stable id so the control plane can
    # tell nodes apart in the room-to-node routing table (server/src/router).
    server_name = "${JANUS_NODE_ID}"

    session_timeout = 60
    reclaim_session_timeout = 30
    candidates_timeout = 45

    debug_level = 4
    debug_timestamps = true
    log_to_stdout = true
}

media: {
    # Matches the UDP range published in the Dockerfile / compose / k8s
    # manifests so NAT'd clients and container port mapping line up.
    rtp_port_range = "${JANUS_RTP_PORT_RANGE}"
    dtls_mtu = 1200
    no_media_timer = 10
    slowlink_threshold = 4
    twcc_period = 200
}

nat: {
    stun_server = "${STUN_SERVER}"
    stun_port = 3478
    nice_debug = false
    ice_tcp = false
    full_trickle = true
    ignore_mdns = true
}

plugins: {
}

transports: {
}

loggers: {
}

events: {
    broadcast = false
}
