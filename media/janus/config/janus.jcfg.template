general: {
    configs_folder = "/opt/janus/etc/janus"
    plugins_folder = "/opt/janus/lib/janus/plugins"
    transports_folder = "/opt/janus/lib/janus/transports"
    events_folder = "/opt/janus/lib/janus/events"
    loggers_folder = "/opt/janus/lib/janus/loggers"

    # Every Janus node gets a unique, stable id so the control plane can
    # tell nodes apart in the room-to-node routing table (server/src/router).
    server_name = "${JANUS_NODE_ID}"

    session_timeout = 60
    reclaim_session_timeout = 30
    candidates_timeout = 45

    debug_level = 4
    debug_timestamps = true
    log_to_stdout = true
}

media: {
    # Matches the UDP range published in the Dockerfile / compose / k8s
    # manifests so NAT'd clients and container port mapping line up.
    rtp_port_range = "${JANUS_RTP_PORT_RANGE}"

    # 1472 = Ethernet MTU (1500) minus IP (20) + UDP (8) headers — avoids
    # DTLS fragmentation on local/LAN paths which adds latency and loss risk.
    # Upstream default is 1200 (conservative); 1472 is correct for non-VPN networks.
    dtls_mtu = 1472

    # Minimum NACK retransmission buffer: 500ms ensures Janus can honour
    # retransmit requests even when RTT spikes briefly (upstream default = 200ms).
    min_nack_queue = 500

    # How many seconds of silence before Janus fires a no-media event.
    # Upstream default is 1 — far too aggressive; raises false positives during
    # normal brief pauses and causes premature hangups under packet loss.
    no_media_timer = 30

    # How many lost packets trigger a slowlink warning to the sender.
    # Upstream default is 4 (or 0 = disabled); 16 avoids spamming slowlink
    # events on minor transient loss, which otherwise causes unnecessary
    # quality reductions by the browser encoder.
    slowlink_threshold = 16

    # How often (ms) Transport-Wide Congestion Control feedback is sent back
    # to senders. Upstream default is 100ms — your previous value of 200ms
    # was too slow for responsive bitrate adaptation.
    twcc_period = 100

    # DSCP marking: 46 (EF — Expedited Forwarding) tells network equipment
    # to prioritise media packets. Harmless if the network ignores it.
    dscp = 46
}

nat: {
    stun_server = "${STUN_SERVER}"
    stun_port = 3478
    nice_debug = false
    ice_tcp = false
    full_trickle = true
    ignore_mdns = true
}

plugins: {
}

transports: {
}

loggers: {
}

events: {
    broadcast = false
}
